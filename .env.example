# Ftpreneur — Environment Template
# Copy to .env and fill with real local values
# DO NOT commit .env with real credentials

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = http://localhost:8080/
# Set to true only in production with HTTPS
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
app.appTimezone = Asia/Kolkata

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ftpreneur
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Run: php spark key:generate
encryption.key = hex2bin:YOUR_GENERATED_KEY

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# FTPRENEUR — ADMIN SEEDER (PHASE 2)
#--------------------------------------------------------------------
# Used only by: php spark db:seed AdminSeeder
# If any value missing, seeder aborts safely — never uses defaults.
# Password must be >=10 chars; will be hashed with password_hash().
# ADMIN_SEED_NAME  = Full Name
# ADMIN_SEED_EMAIL =
# ADMIN_SEED_PASSWORD =

#--------------------------------------------------------------------
# FTPRENEUR — RAZORPAY (FUTURE — PHASE 10)
#--------------------------------------------------------------------
# These are placeholders only for now. Do NOT fill with live secrets
# until payment integration phase. Keep .env out of git.
# razorpay.keyId =
# razorpay.keySecret =
# razorpay.webhookSecret =
